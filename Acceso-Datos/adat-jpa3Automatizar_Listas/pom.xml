<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Debe coincidir con el groupId y artifactId de tu proyecto -->
    <groupId>com.dam2.goya</groupId>
    <artifactId>adat-jpa3Automatizar_Listas</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Evita los mensajes de info de SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.16</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.5.2.Final</version>
        </dependency>
        <!-- Conector MariaDB (cámbialo si usas MySQL) -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.3.3</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.hibernate.tool</groupId>
                <artifactId>hibernate-tools-maven</artifactId>
                <version>6.5.2.Final</version>

                <!-- Descomenta este bloque solo si quieres que las clases se generen
                     solas en cada build (machacaría tus cambios en las entidades).
                     Si no, lánzalo a mano: Run As > Maven build > hibernate-tools:hbm2java
                <executions>
                    <execution>
                        <id>generate-entities</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>hbm2java</goal>
                        </goals>
                    </execution>
                </executions>
                -->

                <configuration>
                    <!-- Carpeta donde se dejan las clases generadas -->
                    <outputDirectory>${project.basedir}/src/main/java</outputDirectory>
                    <!-- Paquete de las entidades -->
                    <packageName>model</packageName>
                    <ejb3>true</ejb3>
                    <jdk5>true</jdk5>
                    <properties>
                        <hibernate.connection.driver_class>org.mariadb.jdbc.Driver</hibernate.connection.driver_class>
                        <hibernate.connection.url>jdbc:mariadb://localhost:3306/naciones</hibernate.connection.url>
                        <hibernate.connection.username>profe</hibernate.connection.username>
                        <hibernate.connection.password>abc123</hibernate.connection.password>
                        <hibernate.dialect>org.hibernate.dialect.MariaDBDialect</hibernate.dialect>
                        <hibernate.default_catalog>naciones</hibernate.default_catalog>
                        <hibernate.default_schema>naciones</hibernate.default_schema>
                    </properties>
                </configuration>

                <dependencies>
                    <!-- El plugin también necesita el conector (cámbialo si usas MySQL) -->
                    <dependency>
                        <groupId>org.mariadb.jdbc</groupId>
                        <artifactId>mariadb-java-client</artifactId>
                        <version>3.3.3</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>